ENVIRONMENT=development
DATABASE_URL=postgresql://parklink_auth:parklink_auth@localhost:5433/parklink_auth_db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Requests must carry the gateway's secret (X-Gateway-Secret) or the
# service-to-service key. Must match the gateway / the other services.
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-change-me
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# Called when an account is suspended/closed/deleted (pause spots, cancel
# bookings, drop push tokens).
PARKING_SERVICE_URL=http://localhost:3001
BOOKING_SERVICE_URL=http://localhost:8080
NOTIFICATIONS_SERVICE_URL=http://localhost:8085

# Brevo (transactional email) - https://app.brevo.com/settings/keys/api
# Without a key, no real email is sent -- the 6-digit verification code is
# just logged ("[MAIL][DEV] Código de verificación para ...").
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# Twilio (SMS) - https://console.twilio.com
# Without credentials, no real SMS is sent -- the code is just logged
# ("[SMS][DEV] Código de verificación para ...").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Set to true locally to skip the email verification requirement at
# registration and login. Cannot be true in production (see config.py).
SKIP_EMAIL_VERIFICATION=false

# Set to true to skip phone verification at registration -- unlike the email
# flag above, this one is allowed in production too (sending real SMS needs a
# paid Twilio number).
SKIP_PHONE_VERIFICATION=false

# Cloudflare R2 (S3-compatible object storage) - avatars are uploaded here.
# Create a bucket at https://dash.cloudflare.com -> R2, enable "Public access"
# (gives you the r2.dev URL for R2_PUBLIC_URL) and create an API token
# (R2 > Manage API Tokens) scoped to that bucket for the access key pair.
# parking-service uses the same bucket/credentials for parking-spot photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Contact address shown in emails.
SUPPORT_EMAIL=contacto@parklink.com.ar

# Sentry error reports. Empty DSN = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional tuning (these are the defaults).
# EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=15
# PHONE_VERIFICATION_CODE_EXPIRE_MINUTES=15
# REGISTRATION_VERIFICATION_GRACE_MINUTES=30
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# ACCOUNT_DELETION_GRACE_DAYS=7
# TERMS_VERSION=2026-10-15
# ACCOUNT_LIFECYCLE_JOB_ENABLED=true
# ACCOUNT_LIFECYCLE_JOB_INTERVAL_SECONDS=3600

# Demo data: example owners and drivers created at startup (idempotent). false turns it off.
SEED_DEMO_DATA=true
