ENVIRONMENT=development
DATABASE_URL=postgresql://parklink_auth:parklink_auth@localhost:5433/parklink_auth_db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Brevo (transactional email) - https://app.brevo.com/settings/keys/api
# Without a key, no real email is sent -- the 6-digit verification code is
# just logged ("[MAIL][DEV] Código de verificación para ...").
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# Twilio (SMS) - https://console.twilio.com
# Without credentials, no real SMS is sent -- the code is just logged
# ("[SMS][DEV] Código de verificación para ...").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Set to true locally to skip the email/phone verification requirement at
# registration and login
SKIP_EMAIL_VERIFICATION=false