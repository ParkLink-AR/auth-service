ENVIRONMENT=development
DATABASE_URL=postgresql://parklink_auth:parklink_auth@localhost:5433/parklink_auth_db

# Public URL this service is reachable at (used for links/logo in emails)
PUBLIC_BASE_URL=http://localhost:8000

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Brevo (transactional email) - https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# Set to true locally to skip the email verification requirement at login
SKIP_EMAIL_VERIFICATION=false