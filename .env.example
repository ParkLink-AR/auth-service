ENVIRONMENT=development
DATABASE_URL=postgresql://parklink_auth:parklink_auth@localhost:5433/parklink_auth_db

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Brevo (transactional email) - https://app.brevo.com/settings/keys/api
# Without a key, no real email is sent -- the 6-digit verification code is
# just logged ("[MAIL][DEV] Código de verificación para ...").
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina

# WhatsApp Cloud API (Meta) - https://developers.facebook.com/apps
# 1. Create a Meta app -> add the "WhatsApp" product -> WhatsApp > API Setup
#    gives you a phone number ID and a temporary access token (generate a
#    permanent one under System Users for real use, the temporary one expires
#    in 24h).
# 2. WhatsApp Manager > Account tools > Message templates > create one with
#    category AUTHENTICATION (Meta writes the body text itself, you only pick
#    the language) -- approval usually takes minutes. WHATSAPP_TEMPLATE_NAME/
#    WHATSAPP_TEMPLATE_LANG below must match exactly.
# Without WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID, no real message is
# sent -- the code is just logged ("[WHATSAPP][DEV] Código de verificación para ...").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=es_AR
WHATSAPP_API_VERSION=v21.0

# Set to true locally to skip the email verification requirement at
# registration and login. Cannot be true in production (see config.py).
SKIP_EMAIL_VERIFICATION=false

# Set to true to skip phone verification at registration -- unlike the email
# flag above, this one is allowed in production too. Leave it false once
# WhatsApp is configured above.
SKIP_PHONE_VERIFICATION=false

# Cloudflare R2 (S3-compatible object storage) - avatars are uploaded here.
# Create a bucket at https://dash.cloudflare.com -> R2, enable "Public access"
# (gives you the r2.dev URL for R2_PUBLIC_URL) and create an API token
# (R2 > Manage API Tokens) scoped to that bucket for the access key pair.
# parking-service uses the same bucket/credentials for parking-spot photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=